# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user and machine-local state
xcuserdata/
*.xcuserstate
DerivedData/
/.xcode-derived/
*.xccheckout
*.xcscmblueprint

# Swift Package Manager output and local IDE state
.build/
.swiftpm/

# Generated coverage profile
/default.profraw

# Generated release output. Keep scripts, SparkleTools, appcast.xml, and docs.
/Releases/build/
/Releases/dist/
/Releases/*.xcarchive
/Releases/*.app
/Releases/*.zip
/Releases/*.dmg
/Releases/*.dSYM
/Releases/private/

# Maintainer-only documentation. Never publish credentials or private procedures.
/docs-private/

# Local convenience aliases
/Ongaku-desktop
/Ongaku


# 管理ファイル
website/
dontUpload/
